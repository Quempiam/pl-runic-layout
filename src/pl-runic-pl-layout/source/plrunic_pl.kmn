c Keyman keyboarf for polish runic with PL hints

store(&Version) "10.0"
store(&NAME) 'Polski (runiczny) norse font'
store(&VISUALKEYBOARD) 'plrunic_pl.kvks'
store(&BITMAP) 'plrunic.ico'
store(&LAYOUTFILE) 'plrunic_pl.keyman-touch-layout'
store(&COPYRIGHT) 'Copyright © Vuko Drag guy man'
store(&KEYBOARDVERSION) '1.2'
store(&TARGETS) 'windows linux iphone androidphone'

begin Unicode > use(main)

group(main) using keys

+ [K_SPACE] > U+0020
+ [SHIFT K_SPACE] > U+202f

+ [K_0] > U+16c3
+ [SHIFT K_0] > U+0029

+ [K_1] > U+16a8
+ [SHIFT K_1] > U+0021
+ [ALT K_1] > '¡'
+ [SHIFT ALT K_1] > '¡'

+ [K_2] > U+16d2
+ [SHIFT K_2] > U+0040

+ [K_3] > U+16b4
+ [SHIFT K_3] > U+0023

+ [K_4] > U+16de
+ [SHIFT K_4] > U+0024

+ [K_5] > U+16d6
+ [SHIFT K_5] > U+0025

+ [K_6] > U+16a0
+ [SHIFT K_6] > U+005e

+ [K_7] > U+16b7
+ [SHIFT K_7] > U+0026

+ [K_8] > U+16bb
+ [SHIFT K_8] > U+002a

+ [K_9] > U+16c1
+ [SHIFT K_9] > U+0028

+ [K_A] > U+16a8
+ [SHIFT K_A] > U+16a8
+ [ALT K_A] > 'ᛇ'
+ [SHIFT ALT K_A] > 'ᛇ'

+ [K_B] > U+16d2
+ [SHIFT K_B] > U+16d2

+ [K_C] > U+16b4
+ [SHIFT K_C] > U+16b4
+ [ALT K_C] > 'К'
+ [SHIFT ALT K_C] > 'K'

+ [K_D] > U+16de
+ [SHIFT K_D] > U+16de
+ [ALT K_D] > 'ᛥ'
+ [SHIFT ALT K_D] > 'ᛥ'

+ [K_E] > U+16d6
+ [SHIFT K_E] > U+16d6
+ [ALT K_E] > 'ᛢ'
+ [SHIFT ALT K_E] > 'ᛢ'

+ [K_F] > U+16a0
+ [SHIFT K_F] > U+16a0

+ [K_G] > U+16b7
+ [SHIFT K_G] > U+16b7
+ [ALT K_G] > '⚝'
+ [SHIFT ALT K_G] > '⚝'

+ [K_H] > U+16bb
+ [SHIFT K_H] > U+16bb

+ [K_I] > U+16c1
+ [SHIFT K_I] > U+16c1

+ [K_J] > U+16c3
+ [SHIFT K_J] > U+16c3

+ [K_K] > U+16b2
+ [SHIFT K_K] > U+16b2

+ [K_L] > U+16da
+ [SHIFT K_L] > U+16da
+ [ALT K_L] > 'ᚹ'
+ [SHIFT ALT K_L] > 'ᚹ'

+ [K_M] > U+16d7
+ [SHIFT K_M] > U+16d7

+ [K_N] > U+16be
+ [SHIFT K_N] > U+16be
+ [ALT K_N] > 'ᛡ'
+ [SHIFT ALT K_N] > 'ᚼ'

+ [K_O] > U+16df
+ [SHIFT K_O] > U+16df
+ [ALT K_O] > 'ᛜ'
+ [SHIFT ALT K_O] > 'ᛜ'

+ [K_P] > U+16c8
+ [SHIFT K_P] > U+16c8

+ [K_Q] > U+16e5
+ [SHIFT K_Q] > U+16e5

+ [K_R] > U+16b1
+ [SHIFT K_R] > U+16b1

+ [K_S] > U+16ca
+ [SHIFT K_S] > U+16ca
+ [ALT K_S] > 'ᛋ'
+ [SHIFT ALT K_S] > 'ᛋ'

+ [K_T] > U+16cf
+ [SHIFT K_T] > U+16cf
+ [ALT K_T] > 'ᚦ'
+ [SHIFT ALT K_T] > 'ᚦ'

+ [K_U] > U+16a2
+ [SHIFT K_U] > U+16a2
+ [ALT K_U] > 'ᚦ'
+ [SHIFT ALT K_U] > 'ᚦ'

+ [K_V] > U+16b8
+ [SHIFT K_V] > U+16b8
+ [ALT K_V] > '᛭'

+ [K_W] > U+16dd
+ [SHIFT K_W] > U+16dd

+ [K_X] > U+16ef
+ [SHIFT K_X] > U+16ef
+ [ALT K_X] > 'ᛠ'
+ [SHIFT ALT K_X] > 'ᛠ'

+ [K_Y] > U+16a4
+ [SHIFT K_Y] > U+16a4

+ [K_Z] > U+16c9
+ [SHIFT K_Z] > U+16c9
+ [ALT K_Z] > '⫯'
+ [SHIFT ALT K_Z] > '⫯'

+ [K_COLON] > U+003b
+ [SHIFT K_COLON] > U+16ec

+ [K_EQUAL] > U+003d
+ [SHIFT K_EQUAL] > U+002b

+ [K_COMMA] > U+002c
+ [SHIFT K_COMMA] > U+003c

+ [K_HYPHEN] > U+002d
+ [SHIFT K_HYPHEN] > U+005f

+ [K_PERIOD] > U+ff61
+ [SHIFT K_PERIOD] > U+003e

+ [K_SLASH] > U+002f
+ [SHIFT K_SLASH] > U+003f
+ [ALT K_SLASH] > '¿'
+ [SHIFT ALT K_SLASH] > '¿'

+ [K_BKQUOTE] > U+15d5
+ [SHIFT K_BKQUOTE] > U+15d2

+ [K_LBRKT] > U+005b
+ [SHIFT K_LBRKT] > U+007b

+ [K_BKSLASH] > U+005c
+ [SHIFT K_BKSLASH] > U+007c

+ [K_RBRKT] > U+005d
+ [SHIFT K_RBRKT] > U+007d

+ [K_QUOTE] > U+0027
+ [SHIFT K_QUOTE] > U+0022

+ [K_oE2] > U+005c
+ [SHIFT K_oE2] > U+007c


